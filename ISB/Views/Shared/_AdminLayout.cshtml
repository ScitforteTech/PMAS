
@model ISB.Models.mainModel;

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.tailwindcss.com"></script>
  

</head>
<body>
    <div class="header">
      
        <button class="toggle-btn" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button> <!-- Toggle Button -->
        <img src="https://placehold.co/100x40" alt="Logo" />
        <div class="icons">
            <img src="https://placehold.co/30x30" alt="Company Logo" />
            <span> Company</span>
            <i class="fas fa-bell"></i>
            <i class="fas fa-cog"></i>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="profile">
            <img src="https://placehold.co/40x40" alt="Profile" />
            <span>aakssh</span>
        </div>


        <div class="menu">
            <ul>
                <li><i class="fa-solid fa-border-all"></i>Dashboard</li>
                <li><i class="fas fa-inbox"></i> Inbox</li>
                <li><a href="@Url.Action("docs_details","admin")"><i class="fa-solid fa-book"></i> Docs</a></li>
                <li><a href="@Url.Action("team_details","admin")"><i class="fas fa-briefcase"></i>Plans & Teams </a> </li>
                <li class="dropdown">
                    <i class="fa-brands fa-creative-commons-nd"></i> Work
                    <i class="fas fa-caret-down dropdown-icon"></i>
                    <ul class="dropdown-menu">
                        <li> <a href="@Url.Action("task_details","admin")">Task</a></li>
                        <li>Time Entries</li>
                        <li>Time Sheet </li>
                        <li><a href="@Url.Action("project_details","admin")">Project</a></li>

                    </ul>
                </li>
                <li><i class="fas fa-users"></i> <a href="@Url.Action("employee_details","admin")">Employees</a></li>
                <li><a href="@Url.Action("audit_details","admin")"><i class="fas fa-dollar-sign"></i> Audit</a></li>
                <li><i class="fas fa-chart-line"></i> Calender</li>
                <li><i class="fas fa-chart-line"></i> Survey</li>
                <li><i class="fas fa-chart-line"></i> Reports</li>

                <li class="dropdown">
                    <i class="fa-solid fa-gear"></i> Settings
                    <i class="fas fa-caret-down dropdown-icon"></i>
                    <ul class="dropdown-menu">
                        <li><a href="@Url.Action("companies_detail","admin")">Company Setting</a></li>
                        <li><a href="@Url.Action("client_details","admin")">Clients</a></li>
                        <li><a href="@Url.Action("roles_details","admin")">Roles Setting</a></li>
                        <li><a href="@Url.Action("StakeholderEngagement_details","admin")"> Stakeholder Engagement</a></li>
                        <li><a href="@Url.Action("Communication_Effectivenes_details","admin")"> Communication Effectivenes</a></li>
                        <li><a href="@Url.Action("risk_mangamentDetails","admin")"> Risk Mangament</a></li>
                        <li>
                            <a href="@Url.Action("ComplianceStandardsDetails","admin")"> Compliance Standards</a>
                          
                          </li>
                        <li>
                            <a href="@Url.Action("issueandchallenges_Details","admin")">   Issue and Challenges</a>

                        </li>
                     
                        <li>Location & Organization</li>
                        <li><a href="@Url.Action("departments_details","admin")">Department &  Processes</a></li>
                        <li>System Setting</li>
                        <li><a href="@Url.Action("project_priority","admin")">Priorities</a></li>
                        <li><a href="@Url.Action("project_status","admin")">Status Setting</a> </li>
                        <li><a href="@Url.Action("project_type","admin")">Type Setting</a> </li>
                        <li>Currency Setting</li>
                    </ul>
                </li>
            </ul>
        </div>


    </div>
    <div>
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    
    @RenderSection("Scripts", false)
   
</body>
</html>
<style>
    .menu ul li a {
        /* color: rgba(var(--bs-link-color-rgb),var(--bs-link-opacity,1)); */
        color: black;
        text-decoration: none;
    }
</style>

<script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const content = document.getElementById('content');
      sidebar.classList.toggle('active');
      content.classList.toggle('active');
    }
</script>