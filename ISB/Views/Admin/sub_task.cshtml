@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
        <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">

    <div class="title">Sub Tasks Details</div>


    <table class="table">
        <thead>
            <tr>
                <th>
                    Task Name
                </th>
                <th>
                    Assigned To
                </th>
                <th>
                    Due date
                </th>
                <th>
                  Risk
                </th>

                <th>Status</th>
                <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var data in Model.subTask_details)
            {
                    <tr>

                        <td>@data.tittle</td>
                        <td>@data.emp_details.name</td>
                        <td>@data.due_date</td>

                        <td>
                        @data.due_date


                        </td>

                    <td>
                        @data.risl_details.Risk_factor & @data.risl_details.total_scoring


                    </td>
                        <td class="action">
                            <i class="fas fa-ellipsis-v action-icon"></i>
                            <ul class="action-menu">
                                <li><a href="@Url.Action("update_subtasks","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</a></li>
                                @* <li><a href="@Url.Action("view_task","admin",new{id= data.task_id})"><i class="fa-solid fa-eye"></i>View</a></li> *@

                                <li><a href="@Url.Action("delete_subtask","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                            </ul>
                        </td>
                    </tr>
            }

            @if (TempData["msg"] != null)
            {
                    <tr>
                        <td class="text-center" colspan="5">@TempData["msg"]</td>
                    </tr>
            }

        </tbody>
    </table>


</div>
<!-- Modal -->

<style>
    body {
        background-color: #f8f9fa;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
        background-color: #e83e8c;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;
            background-color: #e83e8c;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

</style>

