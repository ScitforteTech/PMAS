@model ISB.Models.mainModel;

<div class="content" id="content">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Plan Pillar</h5>
                </div>
    <form method="post" >
    <div class="modal-body">
        <input type="hidden" name="plan_id" value="@Model.planPillar_data.plan_id" />
            <input type="hidden" name="id" value="@Model.planPillar_data.id" />
        <div class="row">

            <div class="col">
                <label for="employeeName" class="form-label"> Name </label>
                <input type="text" value="@Model.planPillar_data.name" required name="name" class="form-control" id="employeeName" placeholder="e.g. John Doe">
            </div>

        </div>

        <div class="row">

            <div class="col">
                <label for="employeeName" class="form-label"> Description </label>
                                <textarea required name="description" class="form-control" id="employeeDescription" rows="4">@Model.planPillar_data.description</textarea>
            </div>

        </div>

    </div>
    <div class="modal-footer">

        <input type="submit" class="btn btn-primary" value="Save">
    </div>
</form>
</div>
        </div>
    </div>
</div>