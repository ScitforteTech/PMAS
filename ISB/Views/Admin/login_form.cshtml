@{
	Layout = null;
}
<html>
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
</head>
<body class="flex items-center justify-center min-h-screen bg-gradient-to-r from-gray-700 to-blue-900">
    <div class="bg-gray-800 p-8 rounded-lg shadow-lg w-80">
        <form method="post">
            <div class="mb-4">
                <div class="flex items-center border-b border-gray-600 py-2">
                    <i class="fa-solid fa-envelope text-gray-400 mr-3"></i>
                    <input name="logined_email" class="appearance-none bg-transparent border-none w-full text-gray-300 mr-3 py-1 px-2 leading-tight focus:outline-none" type="text" placeholder="Email" aria-label="Username">
                </div>
            </div>
            <div class="mb-6">
                <div class="flex items-center border-b border-gray-600 py-2">
                    <i class="fas fa-lock text-gray-400 mr-3"></i>
                    <input name="logined_pass" class="appearance-none bg-transparent border-none w-full text-gray-300 mr-3 py-1 px-2 leading-tight focus:outline-none" type="password" placeholder="Password" aria-label="Password">
                </div>
            </div>
            <div class="flex items-center justify-center">
                <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full w-full">
                    LOGIN
                </button>
            </div>
        </form>
        <div class="mt-4 text-center">
            <a href="#" class="text-blue-500 hover:text-blue-700 text-sm">I forgot password?</a>
        </div>
    </div>
</body>
</html>