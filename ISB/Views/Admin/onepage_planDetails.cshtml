@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">
    <partial name="_planandteams" />
    <h3 class="text-2xl font-bold"> One Page Plan</h3>

    <div class="search-bar">

        <div class="container text-end">
            <button class="btn bg-blue-500  hover:bg-blue-700 text-white" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">Add One page Plan</button>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>

                <th>
                    Tittle

                </th>

                <th>Team</th>

                <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var data in Model.oneplan_Details)
            {
                <tr>

                    <td>@data.name</td>

                    <td>@data.team_details.team_name </td>


                    <td class="action">
                        <i class="fas fa-ellipsis-v action-icon"></i>
                        <ul class="action-menu">
                            <li><a href="@Url.Action("update_plan","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</a></li>
                            <li><a href="@Url.Action("plan_report","admin",new{id = data.id})">Report</a></li>
                            <li><a href="@Url.Action("delete_plan","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                        </ul>
                    </td>
                </tr>
            }

            @if (TempData["msg"] != null)
            {
                <tr>
                    <td class="text-center" colspan="5">@TempData["msg"]</td>
                </tr>
            }

        </tbody>
    </table>


</div>
<!-- Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create One plan page</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="add_oneplan" asp-controller="Admin">
                    <div class="modal-body">
                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Parent Plan </label>
                                <select name="parent_Plan" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.plan_Details)
                                    {
                                        <option value=@data.id>@data.name</option>
                                    }
                                </select>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Name </label>
                                <input type="text" required name="name" class="form-control" id="employeeName" placeholder="e.g. John Doe">
                            </div>

                        </div>

                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Team </label>
                                <select name="team" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.team_details)
                                    {
                                        <option value=@data.id>@data.team_name</option>
                                    }
                                </select>
                            </div>

                        </div>
                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Description </label>
                                <textarea required name="description" class="form-control" id="employeeDescription" rows="4" placeholder="Enter a brief description..."></textarea>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Time Frame</label>
                                
                                <input type="text" required name="timeframe" class="form-control" id="employeeName" placeholder="e.g. John Doe">
                            </div>
                            <div class="col">
                                <label for="employeeName" class="form-label"> Type</label>
                                <select name="type" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.planType_Details)
                                    {
                                        <option value=@data.id>@data.name</option>
                                    }
                                </select>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">

                        <input type="submit" class="btn btn-primary" value="Save">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #f8f9fa;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

</style>





