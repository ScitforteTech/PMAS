
@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
        <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">

    <div class="title">Audit</div>
    <div class="search-bar">
        <select>
            <option value="all">All</option>
        </select>
        <form method="get" class="d-flex">
            <input placeholder="Search" type="text" name="search_text" />
            <button class="btn-search">Search</button>
        </form>
        <div class="container text-end">
            <a class="btn btn-primary" href="@Url.Action("audit_projectDetails","admin")">Audit Project Details</a>
            <button class="btn btnadd" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">Add Audit</button>
        </div>
    </div>


    <table class="table">
        <thead>
            <tr>
                <th>
                  Tittle
                </th>
                <th>
                    Assigned To
                </th>
                <th>
                 Due Date               
                 </th>
            <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var data in Model.audit_datails)
            {
                    <tr>

                        <td>@data.Tittle</td>
                        <td>@data.empDetails.name</td>
                        <td>@data.Due_Date</td>

                      
                        <td class="action">
                            <i class="fas fa-ellipsis-v action-icon"></i>
                            <ul class="action-menu">
                                <li><a href="@Url.Action("update_audit","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</a></li>
                                <li><a href="@Url.Action("view_aduit","admin",new{id= data.id})"><i class="fa-solid fa-eye"></i>View</a></li>

                                <li><a href="@Url.Action("delete_audit","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                            </ul>
                        </td>
                    </tr>
            }

            @if (TempData["msg"] != null)
            {
                    <tr>
                        <td class="text-center" colspan="5">@TempData["msg"]</td>
                    </tr>
            }

        </tbody>
    </table>


</div>
<!-- Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Audit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>Audit Details</h6>
                    <form method="post" asp-action="add_audit" asp-controller="admin" enctype="multipart/form-data">
                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label">Tittle</label>
                                <input type="text" class="form-control" id="employeeName" name="Tittle" placeholder="e.g. John Doe" required>
                            </div>
                    
                            <div class="col">
                                <label for="employeeName" class="form-label">Due Date</label>
                                <input type="date" min="@DateTime.Now.ToString("yyyy-mm-dd")" class="form-control" id="employeeName" name="Due_Date" placeholder="e.g. John Doe" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label">Project </label>
                                <select name="project_id" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.project_details)
                                    {
                                        <option value=@data.Project_id>@data.name</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label for="projectStatus" class="form-label">Task </label>
                                <select name="task_id" required class="form-select" id="projectStatus">
                                    <option hidden>nothing selected</option>
                                    @foreach (var data in Model.task_details)
                                    {
                                            <option value=@data.task_id>  @data.name</option>
                                    }
                                </select>
                            </div>

                            <div class="col">
                                <label for="projectStatus" class="form-label">Auditor</label>
                                <select name="assignedauditor" required class="form-select" id="projectStatus">
                                    <option hidden>nothing selectede</option>
                                    @foreach (var data in Model.employee_details)
                                    {
                                            <option value=@data.id>  @data.name</option>
                                    }
                                </select>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col">

                                <label for="priorityLevel" class="form-label">Priority Level</label>
                                <select name="Priority_id" required class="form-select" id="priorityLevel">
                                    <option hidden>nothing selected.</option>
                                    @foreach (var data in Model.auditPriorityDetails)
                                    {
                                            <option value=@data.id>
                                            @data.name
                                            </option>
                                    }
                                </select>

                            </div>
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Audit Type </label>
                                <select name="Type_id" required class="form-select" id="salutation">

                                    <option hidden>nothing selected.</option>
                                    @foreach (var data in Model.audittype)
                                    {
                                            <option value=@data.id>
                                            @data.name
                                            </option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Attachment</label>
                                <input type="file" class="form-control" id="employeeName" name="Attachment" placeholder="write a Description" required />


                            </div>
                        </div> 
                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Audit Scope</label>
                                <textarea class="form-control" id="employeeName" name="AuditScope" placeholder="write a Description" required>
                                    </textarea>

                            </div>
                           </div>
                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Audit Objective</label>
                                <textarea class="form-control" id="employeeName" name="AuditObjectives" placeholder="write a Description" required>
                                    </textarea>

                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Comments</label>
                                <textarea class="form-control" id="employeeName" name="Comments" placeholder="write a Description" required>
                                    </textarea>

                            </div>
                          
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-5">Save</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #f8f9fa;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
      
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;

            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

</style>
