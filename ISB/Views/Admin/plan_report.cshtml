@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<style>
    .accordion {
        margin: 20px auto;
    }

    .accordion-item {
        border: 1px solid #ccc;
        margin-bottom: 5px;
    }



    .accordion-button {
        width: 100%;
        padding: 10px;
        text-align: left;
        border: none;
        background: none !important;
        cursor: pointer;
        color:black;
    }

    .accordion-button:active {
        width: 100%;
        padding: 10px;
        text-align: left;
        border: none;
            color: black;
        background: none !important;
        cursor: pointer;
    }

    .accordion-body {
        display: none; /* Hidden by default */
        padding: 10px;
        border-top: 1px solid #ccc;
    }

    .accordion-button:not(.collapsed) {
        /* color: var(--bs-accordion-active-color);  */
        /* background-color: var(--bs-accordion-active-bg); */
        /* box-shadow: inset 0 calc(-1* var(--bs-accordion-border-width)) 0 var(--bs-accordion-border-color); */
    }

    body {
        background-color: #f8f9fa;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

 

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

  
        </style>
<div class="content" id="content">

    <h3 class="text-2xl font-bold"> Plan Details</h3>

    <div class="accordion">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button ">Plan Pillars</button>
            </h2>
            <div class="accordion-body">
                <div class="container text-end">
                    <button class="btn bg-blue-500  hover:bg-blue-700 text-white" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">Add Pillar</button>
                </div>
               <div class="conatiner d-flex justify-content-center gap-4 ">
                    @if (TempData["msg"]!=null){
                        <h5>@TempData["msg"]</h5>
                    }
                    
            @foreach( var data in Model.planPillar_Details){
                        <div class="card w-25">
                            <div class="card-header bg-blue-500  h-10 text-white">
                                <div class="container d-flex justify-content-between align-items-center">
                                    <h6>@data.name</h6>
                                    <div>
                                        <a class="text-white" href="@Url.Action("del_planPillar", new { id = data.id })"
                                           onclick="return confirm('Are you sure you want to delete this plan pillar?');">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                        <a class="text-white" href="@Url.Action("edit_planPillar", new { id = data.id })" >
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                              @data.description
                           

                            </div>
                            </div>
            }
              
               </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button">Task </button>
            </h2>
            <div class="accordion-body">

                <div class="container text-end">
                    <button class="btn bg-blue-500  hover:bg-blue-700 text-white" data-bs-toggle="modal" data-bs-target="#addtaskModal">Add Task</button>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                Task Name
                            </th>
                            <th>
                                Assigned To
                            </th>
                            <th>
                                Start Date
                            </th>

                            <th>Status</th>
                            <th class="action">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var data in Model.task_details)
                        {
                            <tr>

                                <td>@data.name</td>
                                <td>@data.emp_data.name</td>
                                <td>@data.due_date</td>

                                <td>
                                    @data._status.name


                                </td>
                                <td class="action">
                                    <i class="fas fa-ellipsis-v action-icon"></i>
                                    <ul class="action-menu">
                                        <li><a href="@Url.Action("update_PlanTask","admin",new{id = data.task_id})"><i class="fas fa-edit"></i>Edit</a></li>
                                        <li><a href="@Url.Action("view_task","admin",new{id= data.task_id})"><i class="fa-solid fa-eye"></i>View</a></li>

                                        <li><a href="@Url.Action("delete_plantask","admin",new{id = data.task_id})"><i class="fas fa-trash"></i>Delete</a></li>
                                    </ul>
                                </td>
                            </tr>
                        }

                        @if (TempData["msg"] != null)
                        {
                            <tr>
                                <td class="text-center" colspan="5">@TempData["msg"]</td>
                            </tr>
                        }

                    </tbody>
                </table>


            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button">Project</button>
            </h2>
            <div class="accordion-body">

                <div class="container text-end">
                    <button class="btn bg-blue-500  hover:bg-blue-700 text-white" data-bs-toggle="modal" data-bs-target="#addproModal">Add Project</button>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                Project Name
                            </th>
                            <th>
                                Assigned To
                            </th>
                            <th>
                                Start Date
                            </th>
                            <th>
                                End Date
                            </th>
                            <th>Status</th>
                            <th class="action">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var data in Model.project_details)
                        {
                            <tr>

                                <td>@data.name</td>
                                <td>@data.employee_details.name</td>
                                <td>@data.start_date</td>
                                <td>@data.end_date</td>



                                <td>
                                    <a href="@Url.Content("~/documents/" + data.document)" target="_blank" download>
                                        Read Details
                                    </a>


                                </td>
                                <td class="action">
                                    <i class="fas fa-ellipsis-v action-icon"></i>
                                    <ul class="action-menu">
                                        <li><a href="@Url.Action("update_planproject","admin",new{id = data.Project_id})"><i class="fas fa-edit"></i>Edit</a></li>
                                        <li><a href="@Url.Action("delete_planproject","admin",new{id = data.Project_id})"><i class="fas fa-trash"></i>Delete</a></li>
                                    </ul>
                                </td>
                            </tr>
                        }

                        @if (TempData["msg"] != null)
                        {
                            <tr>
                                <td class="text-center" colspan="5">@TempData["msg"]</td>
                            </tr>
                        }

                    </tbody>
                </table>


            </div>
        </div>
    </div>



</div>
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Plan Pillar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="add_planPillar" asp-controller="Admin">
                    <div class="modal-body">
                       <input type="hidden" name="plan_id" value="@Model.plan_data.id" />

                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Name </label>
                                <input type="text" required name="name" class="form-control" id="employeeName" placeholder="e.g. John Doe">
                            </div>

                        </div>

                        <div class="row">

                            <div class="col">
                                <label for="employeeName" class="form-label"> Description </label>
                                <textarea required name="description" class="form-control" id="employeeDescription" rows="4" placeholder="Enter a brief description..."></textarea>
                            </div>

                        </div>

                    </div>
                    <div class="modal-footer">

                        <input type="submit" class="btn btn-primary" value="Save">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addtaskModal" tabindex="-1" aria-labelledby="addtaskModalLabel" aria-hidden="true">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>Task Details</h6>
                    <form method="post" asp-action="add_PlanTask" asp-controller="admin" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" name="plan_id" value="@Model.plan_data.id"  />
                            <div class="col">
                                <label for="employeeName" class="form-label">Task Name</label>
                                <input type="text" class="form-control" id="employeeName" name="name" placeholder="e.g. John Doe" required>
                            </div>
                            <div class="col">
                                <label for="employeeEmail" class="form-label">Project Name</label>
                                <select name="project_" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.project_details)
                                    {
                                        <option value=@data.Project_id>@data.name</option>
                                    }
                                </select>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col">
                                <label for="employeeName" class="form-label">Due Date</label>
                                <input type="date" min="@DateTime.Now.ToString("yyyy-mm-dd")" class="form-control" id="employeeName" name="due_date" placeholder="e.g. John Doe" required>
                            </div>
                            <div class="col">
                                <label for="projectStatus" class="form-label">Task Status</label>
                                <select name="task_statuss" required class="form-select" id="projectStatus">
                                    <option hidden>nothing selected</option>
                                    @foreach (var data in Model.task_statusdetails)
                                    {
                                        <option value=@data.id>  @data.name</option>
                                    }
                                </select>
                            </div>

                            <div class="col">
                                <label for="projectStatus" class="form-label">Task Type</label>
                                <select name="task_types" required class="form-select" id="projectStatus">
                                    <option hidden>nothing selectede</option>
                                    @foreach (var data in Model.task_typedetails)
                                    {
                                        <option value=@data.id>  @data.name</option>
                                    }
                                </select>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col">

                                <label for="priorityLevel" class="form-label">Priority Level</label>
                                <select name="task_priority" required class="form-select" id="priorityLevel">
                                    <option hidden>nothing selected.</option>
                                    @foreach (var data in Model.task_prioritesDetails)
                                    {
                                        <option value=@data.id>
                                            @data.name
                                        </option>
                                    }
                                </select>

                            </div>
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Assigned to </label>
                                <select name="employee_ids" required class="form-select" id="salutation">

                                    <option hidden>nothing selected.</option>
                                    @foreach (var data in Model.employee_details)
                                    {
                                        <option value=@data.id>
                                            @data.name
                                        </option>
                                    }
                                </select>
                            </div>

                        </div> <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Document </label>
                                <input type="file" name="document" class="form-control">
                            </div>


                        </div>
                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Description</label>
                                <textarea class="form-control" id="employeeName" name="description" placeholder="write a Description" required>
                                    </textarea>

                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-5">Save</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>

