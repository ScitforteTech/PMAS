@model ISB.Models.mainModel;
<div class="containerbox">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        update
                       Task Priority
                    </h5>

                </div>
                <div class="modal-body">
                    <h6>Update   Task Priority Details</h6>
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" name="id" value="@Model.task_prioritesData.id" />

                            <div class="col">
                                <label for="employeeEmail" class="form-label">Name </label>
                                <input type="text" value="@Model.task_prioritesData.name" class="form-control" id="employeeName" name="name" placeholder="e.g. John Doe" required>

                            </div>

                        </div>
                        <div class="row">


                            <div class="col">
                                <label for="employeeEmail" class="form-label">Colour </label>
                                <input type="color" value="@Model.task_prioritesData.colour" name="colour" class="form-control" id="employeeName" required>

                            </div>

                        </div>

                        <div class="row">
                            <div class="col">
                                <label class="form-label">Is Active?</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginYes" value=1 checked>
                                        <label class="form-check-label" for="loginYes">Yes</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginNo" value=0>
                                        <label class="form-check-label" for="loginNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>

                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #f8f9fa;
    }

    .containerbox {
        margin-top: 120px;
        padding: 30px;
    }

    form {
        padding: 10px;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
        background-color: #e83e8c;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;
            background-color: #e83e8c;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

</style>


