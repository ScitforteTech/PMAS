    </div>

    <!-- Company Details with Right-aligned Answers -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">@foreach (var data in Model.companies_details)
                {
                    <div class="card-body">

                        <h5 class="card-title">Company Details</h5>
                        <p><strong>Name:</strong> <span class="float-end">@data.name</span></p>
                        <p><strong>Email:</strong> <span class="float-end">@data.email</span></p>
                        <p><strong>Mobile:</strong> <span class="float-end">@data.Phonenumber</span></p>
                        <p>
                            <strong>Company Website:</strong>
                            <span class="float-end">
                                <a href="@data.website">@data.website</a>
                            </span>
                        </p>
                        <p><strong>Company Address:</strong> <span class="float-end">@data.address</span></p>
                        <p><strong>Default Currency:</strong> <span class="float-end">Rupee</span></p>
                        <p><strong>Default Timezone:</strong> <span class="float-end">@data.city
                            </span>
                        </p>
                        <p>
                            <strong>Status:</strong> <span class="float-end">
                                @if (data.status == 1)
                                {
                                    <span>Activate</span>
                                }
                                else
                                {
                                    <span>Inactivate</span>
                                }
                            </span>
                        </p>
                    </div>
                }
            </div>
        </div>

