@model ISB.Models.mainModel;
<div class="content" id="content">
    <div class="title"><a href="@Url.Action("companies_detail","admin")">Back</a></div>

    <!-- Content Section -->
    <div class="row mb-4">
        <!-- First Item -->   @foreach(var data in Model.companies_details){
            <div class="col-6 d-flex align-items-center">
                <div class="card p-3 border">

                    <div class="d-flex">
                        <div class="mr-5">
                            <!-- Increased margin to add more space -->

                            <img height="100px" width="100px" src="@Url.Content("~/compnanies_logo/"+ data.logo)" class="img-fluid" />
                        </div>
                        <div>
                            <h5 class="card-title">Company</h5>
                            <p class="card-text">
                                Created at -- 
                                <span>@data.dateCurrent</span>

                                <br />
                                Last login at --
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
        <!-- Second Item -->
        <div class="col-md-6 d-flex align-items-center">
            <div class="card p-3 border">
                <div class="d-flex">
                    <div class="mr-5">
                        <!-- Increased margin to add more space -->

                        <img alt="Company Logo" src="https://placehold.co/100x100" class="img-fluid" />
                    </div>
                    <div>
                        <h5 class="card-title">Company</h5>
                        <p class="card-text">
                            Created at -- 
                            <br />
                            Last login at --
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Third Item -->
