@model ISB.Models.mainModel;
<div class="content" id="content">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Audit Rating</h5>
                   
                </div>
                <div class="modal-body">
                    
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" name="id" value="@Model.Audit_Rating_Data.id" />

                            <div class="col">
                                <label for="employeeEmail" class="form-label">Name </label>
                                <input type="text" value="@Model.Audit_Rating_Data.name" class="form-control" id="employeeName" name="name" placeholder="e.g. John Doe" required>

                            </div>

                        </div>
                        <div class="row">


                            <div class="col">
                                <label for="employeeEmail" class="form-label">Colour </label>
                                <input type="color" value="@Model.Audit_Rating_Data.colour" name="colour" class="form-control" id="employeeName" required>

                            </div>

                        </div>

                        <div class="row">
                            <div class="col">
                                <label class="form-label">Is Active?</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginYes" value=1 checked>
                                        <label class="form-check-label" for="loginYes">Yes</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginNo" value=0>
                                        <label class="form-check-label" for="loginNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>
                    </form>

                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>
