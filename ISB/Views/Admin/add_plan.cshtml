@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="text-2xl font-bold">Add Plan</h5>

                </div>
                <div class="modal-body">

                    <form method="post" enctype="multipart/form-data">
                      
                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label">Tittle</label>
                                <input type="text"  class="form-control" id="employeeName" name="name" placeholder="e.g. John Doe" required>

                            </div>
                            <div class="col">
                                <label for="employeeEmail" class="form-label">Time Frame</label>
                                <input type="text" class="form-control" id="employeeName" name="time_frame" placeholder="e.g. John Doe" required>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                
                                <label for="employeeEmail" class="form-label"> Type</label>
                                <select name="type_id" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.planType_Details)
                                    {
                                        <option value=@data.id>@data.name</option>
                                    }
                                </select>
                            </div>
                            <div class="col">

                                <label for="employeeEmail" class="form-label"> Team</label>
                                <select name="team_id" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.team_details)
                                    {
                                        <option value=@data.id>@data.team_name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Description</label>
                                <textarea class="form-control" id="employeeName" name="description" placeholder="write a description" required>
                                    </textarea>

                            </div>
                        </div>



                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>

