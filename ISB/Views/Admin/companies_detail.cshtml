
@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">
    <div class="title">Company</div>
    <div class="search-bar">
        <select>
            <option value="all">All</option>
        </select>
        <form class="d-flex">
            <input placeholder="Search" type="text" name="search_text" />
            <button class="btn-search">Search</button>
		</form>

        <div class="container text-end">
            <a class="btn btnadd bg-blue-500 hover:bg-blue-700 " href="@Url.Action("companyCreatetion","admin")">New Company</a>
        </div>
        
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>logo</th>
                <th>company</th>
                <th>Address</th>
                <th>Status</th>
                <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach(var data in Model.companies_details){
                <tr>

                    <td><img src="@Url.Content("~/compnanies_logo/"+ data.logo)" alt="Alternate Text" style="height:40px" /></td>
                    <td>@data.name</td>
                    <td>@data.address</td>
                    <td>
                        @if (data.status == 1)
                        {
                            <span>Activate</span>
                        }else{
                            <span>Inactivate</span>
                        }
                    </td>
                    <td class="action">
                        <i class="fas fa-ellipsis-v action-icon"></i>
                        <ul class="action-menu">
                            <li>
                                <a href="@Url.Action("companies_data","admin",new{id = data.id})"> <i class="fas fa-eye"></i>
                                    View
                                </a>
                            </li>
                            <li><a href="@Url.Action("update_comapny","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</li>
                            <li><a href="@Url.Action("status_comapny","admin",new{id = data.id})"><i class="fa-solid fa-toggle-on"></i>Status</a></li>
                            <li><a href="@Url.Action("delete_comapny","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                        </ul>
                    </td>
                </tr>
            }
            @if (TempData["msg"] != null)
            {
                <tr>
                    <td class="text-center" colspan="5">@TempData["msg"]</td>
                </tr>
            }

        </tbody>
    </table>


</div>

<style>
    .btnadd{
        color:white;
    }

    .btnadd:hover {
        color: white;
    }
    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }
</style>