<script>
    const fileButton = document.getElementById('fileButton');
    const commentButton = document.getElementById('commentButton');
    const fileSection = document.getElementById('fileSection');
    const commentSection = document.getElementById('commentSection');
    const noCommentFound = document.getElementById('noCommentFound');
    const timesheet=document.getElementById("Timesheet");
    const timesection=document.getElementById("timesheetSection");
    const subTaskButton=document.getElementById("subTAskButton");
    const subtasks_Section=document.getElementById("subtask_Section");
    const history_button=document.getElementById("history_button");
    const history_section=document.getElementById("history_section")
    fileButton.addEventListener('click', () => {
      fileSection.style.display = 'block';
      commentSection.style.display = 'none';

      timesection.style.display="none";
      subtasks_Section.style.display="none";
    });
    timesheet.addEventListener('click', () => {
      fileSection.style.display = 'none';
      commentSection.style.display = 'none';

      timesection.style.display="block";
      subtasks_Section.style.display="none";
    });
    commentButton.addEventListener('click', () => {
      commentSection.style.display = 'block';
      fileSection.style.display = 'none';

      timesection.style.display="none";
      subtasks_Section.style.display="none";
    });
    subTaskButton.addEventListener('click', () => {
      fileSection.style.display = 'none';
      commentSection.style.display = 'none';

      timesection.style.display="none";
      subtasks_Section.style.display="block";
    });
    history_button.addEventListener('click', () => {
      fileSection.style.display = 'none';
      commentSection.style.display = 'none';

      timesection.style.display="none";
      subtasks_Section.style.display="none";
      history_section.style.display="block";
    });
</script>
