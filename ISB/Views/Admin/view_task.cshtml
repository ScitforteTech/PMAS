        <div class="p-4" id="fileSection" style="display: none;">
            <div class="flex items-start mb-4">
                <div class="flex-1">
                    <div class="flex items-center mb-2">
                        <h2 class="text-lg font-bold">Files</h2>

                    </div>
                    <div class="col-12">
                        <form method="post" enctype="multipart/form-data" asp-action="add_file" asp-controller="admin">
                            <input name="file_name" type="file" />
                            <input type="hidden" name="task_ids" value="@Model.task_data.task_id" />
                            <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">
                                Submit
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>
                            File Name
                        </th>
                        <th>
                           Date
                        </th>
                      
                        <th class="action">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var data in Model.files_details)
                    {
                        <tr>
                            <td>@data.file_name</td>
                            <td>@data.date</td>
                            <td class="action">
                                <i class="fas fa-ellipsis-v action-icon"></i>
                                <ul class="action-menu">
                                    <li>
                                        <a href="@Url.Content("~/documents/"+data.file_name)" download style="margin: 10px;" >
                                            <span>Download</span>
                                            <i class="fas fa-download"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="@Url.Content("~/documents/" + data.file_name)" target="_blank" style="margin: 10px;" >
                                            <span>View</span>
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </li>

                                    <li>
                                        <a href="@Url.Action("delete_file","admin",new {ids=data.Id})" style="margin: 10px;" >
                                            <span>Delete</span>
                                            <i class="fa-regular fa-trash-can"></i>
                                        </a>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    }

                    @if (TempData["msg"] != null)
                    {
                        <tr>
                            <td class="text-center" colspan="5">@TempData["msg"]</td>
                        </tr>
                    }

                </tbody>
            </table>


