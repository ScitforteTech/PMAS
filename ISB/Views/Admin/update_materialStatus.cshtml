@model ISB.Models.mainModel;
<div class="content" id="content">
<div class="containerbox">
    <div class="container mt-5">
      
           
                <div class="modal-body">

                <h6 class="text-2xl font-bold ">Update Marital Status Details</h6>
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" name="id" value="@Model.materialStatus_data.id" />

                            <div class="col">
                                <label for="employeeEmail" class="form-label">Name </label>
                                    <input type="text" value="@Model.materialStatus_data.name" class="form-control" id="employeeName" name="name" placeholder="e.g. John Doe" required>

                            </div>

                        </div>
                        <div class="row">


                            <div class="col">
                                <label for="employeeEmail" class="form-label">Colour </label>
                                    <input type="color" value="@Model.materialStatus_data.colour" name="colour" class="form-control" id="employeeName" required>

                            </div>

                        </div>

                        <div class="row">
                            <div class="col">
                                <label class="form-label">Is Active?</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginYes" value=1 checked>
                                        <label class="form-check-label" for="loginYes">Yes</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginNo" value=0>
                                        <label class="form-check-label" for="loginNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>

                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>



