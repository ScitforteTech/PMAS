@model ISB.Models.mainModel;


<div id="content" class="content">
    <div class="containerbox">
        <div class="container mt-5">
            <div class="text-center">
                <h4 class="font-bold text-lg">Update Sub Task Details</h4>
            </div>

            <form  method="post">
                <input type="hidden" name="task_id" value="@Model.subTask_data.task_id" />
                <input type="hidden" name="id" value="@Model.subTask_data.id" />

                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="title">Title <span class="text-red-500">*</span></label>
                    <input value="@Model.subTask_data.tittle" name="tittle" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="title" type="text" placeholder="Enter a task title">
                </div>
                <div class="flex flex-wrap -mx-2 mb-4">
                    <div class="w-full md:w-1/3 px-2 mb-4 md:mb-0">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="start-date">Start Date</label>
                        <input name="start_date" min="@DateTime.Now.ToString("yyyy-mm-dd")" @Model.subTask_data.start_date class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="start-date" type="date" placeholder="Select Date">
                    </div>
                    <div class="w-full md:w-1/3 px-2 mb-4 md:mb-0">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="due-date">Due Date</label>
                        <input name="due_date" min="@DateTime.Now.ToString("yyyy-mm-dd")" @Model.subTask_data.due_date class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="due-date" type="date" placeholder="Select Date">
                    </div>
                    <div class="w-full md:w-1/3 px-2">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="assigned-to">Assigned To</label>
                        <select name="emp_id" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="assigned-to">
                            <option hidden value="@Model.subTask_data.emp_id">@Model.employee_data.name </option>
                            @foreach (var data in Model.employee_details)
                            {
                                <option value="@data.id"> @data.name</option>
                            }
                        </select>
                    </div>
                    <div class="w-full md:w-1/3 px-2">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="assigned-to">Risk Factor</label>
                        <select name="risk_id" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="assigned-to">
                            <option hidden value="@Model.subTask_data.risk_id"> 
                                
                                @Model.risk_data.Risk_factor</option>
                            @foreach (var data in Model.risk_details)
                            {
                                <option value="@data.id"> @data.Risk_factor</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="description">Description</label>
                    <textarea name="discription" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="description" rows="4" placeholder="Enter description">@Model.subTask_data.discription</textarea>
                </div>
                <div class="mb-4">
                    <input name="files_upload" value="@Model.subTask_data.files_upload" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="start-date" type="file" placeholder="Select Date">
                    @* <a href="#" class="text-blue-500"><i class="fas fa-paperclip"></i> Upload File</a> *@
                </div>
                <div class="flex items-center justify-end items-center">


                    <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">
                        Submit
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>