@model ISB.Models.mainModel;
<div class="content" id="content" >
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="text-2xl font-bold">Add   Audit Conclusion  </h5>
                   
                </div>
                <div class="modal-body">
             
                    <form method="post" asp-action="addauditconclusion" asp-controller="admin" enctype="multipart/form-data">
                        <div class="row">

                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Audit Rating</label>
                                <select name="rating_id" required class="form-select" id="salutation">

                                    <option hidden required>nothing selected.</option>
                                    @foreach (var data in Model.Audit_Rating_Details)
                                    {
                                        <option value=@data.id>@data.name</option>
                                    }
                                </select>
                            </div>

                            <div class="col">
                                <label for="employeeEmail" class="form-label">Date</label>
                                <input type="date" class="form-control" id="employeeName" name="Date" placeholder="e.g. John Doe" required>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label"> Summary of Findings</label>
                                <textarea class="form-control" id="employeeName" name="Summary_Findings" placeholder="write a Improvement Suggestions" required>
                                    </textarea>

                            </div>
                        </div>




                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>