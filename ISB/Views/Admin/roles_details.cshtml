
@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">
    <div class="title">Roles</div>
    <div class="search-bar">
        <select>
            <option value="all">All</option>
        </select>
        <form class="d-flex">
            <input placeholder="Search" type="text" name="search_text" />
            <button class="btn-search">Search</button>
        </form>
        <div class="container text-end">
            <button class="btn" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">Add Roles</button>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Roles</th>
               
                <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var data in Model.role_detail)
            {
                <tr>

                    <td>@data.roles_name</td>
                    
                    <td class="action">
                        <i class="fas fa-ellipsis-v action-icon"></i>
                        <ul class="action-menu">

                            <li><a href="@Url.Action("update_roles","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</li>
                             <li><a href="@Url.Action("delete_roles","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                        </ul>
                    </td>
                </tr>
            }
            @if (TempData["msg"] != null)
            {
                <tr>
                    <td class="text-center" colspan="5">@TempData["msg"]</td>
                </tr>
            }

        </tbody>
    </table>

    <div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
        <div class="container mt-5">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Roles</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-action="add_role" asp-controller="Admin">
                    <div class="modal-body">
                        <h6>Roles Details</h6>
                        
                            <div class="row">
                               
                                <div class="col">
                                    <label for="employeeName" class="form-label">Roles </label>
                                    <input type="text" required name="roles_name" class="form-control" id="employeeName" placeholder="e.g. John Doe">
                                </div>
                        </div>
                        
                    </div>
                    <div class="modal-footer">
                     
                        <input type="submit" class="btn btn-primary" value="Save">
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .modal-dialog {
        max-width: 400px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }
</style>
