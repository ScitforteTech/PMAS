@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">

    <h3 class="text-2xl font-bold"> Document    </h3>

    <div class="search-bar">

        <div class="container text-end">

            <a class="btn btnadd bg-blue-500 hover:bg-blue-700 " href="@Url.Action("add_Document","admin")">Add Document</a>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>

                <th>
                  Tittle

                </th>

                <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var data in Model.Docs_Details)
            {
                <tr>

                    <td>@data.Tittle</td>
                    
                    <td class="action">
                        <i class="fas fa-ellipsis-v action-icon"></i>
                        <ul class="action-menu">
                            <li><a href="@Url.Action("update_doc","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</a></li>
                     
                            <li>
                                <a href="@Url.Action("doc_pdf","admin",new{id = data.id})">
                                    <i class="fa-solid fa-download"></i>Download
                                </a>
                            </li>
                             <li> 
                              <i class="fa-regular fa-heart"></i>
                                <form asp-action="Fav_docs" asp-controller="admin" method="post"> 
                                     <input type="hidden" name="id" value="@data.id" /> 
                                     <button type="submit">Add to Favourite</button> 
                                </form> 
                             </li> 
                            <li>
                                <i class="fa-regular fa-copy"></i>
                                <form asp-action="Duplicate_docs" asp-controller="admin" method="post">
                                    <input type="hidden" name="id" value="@data.id" />
                                    <button type="submit">Duplicate</button>
                                </form>
                            </li>
                            <li><a href="@Url.Action("delete_doc","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                        </ul>
                    </td>
                </tr>
            }

            @if (TempData["msg"] != null)
            {
                <tr>
                    <td class="text-center" colspan="5">@TempData["msg"]</td>
                </tr>
            }

        </tbody>
    </table>


</div>
<!-- Modal -->
<style>
    body {
        background-color: #f8f9fa;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

</style>




