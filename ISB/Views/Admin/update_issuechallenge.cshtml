@model ISB.Models.mainModel;
<div class="content" id="content">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Issues and Challenges  Details</h5>
                                   </div>
                <div class="modal-body">
                   
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" name="id" value="@Model.issues_Data.id" />
                            <div class="col">
                                <label for="employeeEmail" class="form-label">  Issue Severity</label>
                                <select name="Issue_Severity"  required class="form-select" id="salutation">

                                    <option hidden value="@Model.issues_Data.Issue_Severity">@Model.issues_Data.Issue_Severity</option>
                                    @foreach (var data in Model.IssueSeverity_details)
                                    {
                                        <option value=@data.name>@data.name</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label for="employeeEmail" class="form-label">  Resolution Status</label>
                                <select name="Resolution_Status" required class="form-select" id="salutation">

                                    <option hidden value="@Model.issues_Data.Resolution_Status">@Model.issues_Data.Resolution_Status</option>
                                    @foreach (var data in Model.ResolutionStatus_details)
                                    {
                                        <option value=@data.name>@data.name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <label for="employeeEmail" class="form-label">  Open Issue</label>
                                <textarea class="form-control" id="employeeName" name="Open_Issue" placeholder="write a Open Issue" required>
                                    @Model.issues_Data.Open_Issue  </textarea>

                            </div>
                        </div>




                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>
