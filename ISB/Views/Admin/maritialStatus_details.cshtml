
@model ISB.Models.mainModel;
@if (TempData["msg1"] != null)
{
    <script>alert('@TempData["msg1"]');</script>
}
<div class="content" id="content">
    <partial name="_statuslinks" />
    <h3 class="text-2xl font-bold">Marital  Status</h3>

    <div class="search-bar">

        <div class="container text-end">
            <button class="btn" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">Add Marital  Status</button>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>

                <th>
                    Tittle

                </th>

                <th>Colour</th>
                <th>Status</th>
                <th class="action">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var data in Model.materialStatus_details)
            {
                <tr>

                    <td>@data.name</td>

                    <td> <div style="height:15px; width:10%; background:@data.colour"></div></td>

                    <td>
                        @if (data.status == 1)
                        {
                            <span>Yes</span>
                        }
                        else
                        {
                            <span>No</span>
                        }
                    </td>

                    <td class="action">
                        <i class="fas fa-ellipsis-v action-icon"></i>
                        <ul class="action-menu">
                            <li><a href="@Url.Action("update_materialStatus","admin",new{id = data.id})"><i class="fas fa-edit"></i>Edit</a></li>

                            <li><a href="@Url.Action("maritalStatusUpdate","admin",new{id = data.id})"><i class="fa fa-toggle-on"></i>Status</a></li>

                            <li><a href="@Url.Action("delete_maritalStatus","admin",new{id = data.id})"><i class="fas fa-trash"></i>Delete</a></li>
                        </ul>
                    </td>
                </tr>
            }

            @if (TempData["msg"] != null)
            {
                <tr>
                    <td class="text-center" colspan="5">@TempData["msg"]</td>
                </tr>
            }

        </tbody>
    </table>


</div>
<!-- Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="container mt-5">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Task Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>Add Marital status Details</h6>
                    <form method="post" asp-action="addmaritial_status" asp-controller="admin" enctype="multipart/form-data">
                        <div class="row">


                            <div class="col">
                                <label for="employeeEmail" class="form-label">Name </label>
                                <input type="text" class="form-control" id="employeeName" name="name" placeholder="e.g. John Doe" required>

                            </div>

                        </div>
                        <div class="row">


                            <div class="col">
                                <label for="employeeEmail" class="form-label">Colour </label>
                                <input type="color" name="colour" class="form-control" id="employeeName" required>

                            </div>

                        </div>

                        <div class="row">
                            <div class="col">
                                <label class="form-label">Is Active?</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginYes" value=1 checked>
                                        <label class="form-check-label" for="loginYes">Yes</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="status" id="loginNo" value=0>
                                        <label class="form-check-label" for="loginNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">Save</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #f8f9fa;
    }

    .modal-dialog {
        max-width: 900px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        margin-bottom: 1rem;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .container {
        margin-top: 50px;
    }

    .modal-body {
        background-color: #fff;
    }

    .modal-footer button {
        width: 100px;
    }

    .btnadd {
        padding: 10px 20px;
        background-color: #e83e8c;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btnadd:hover {
            padding: 10px 20px;
            background-color: #e83e8c;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

</style>




